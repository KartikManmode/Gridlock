# Project Gridlock: Database Environment Configuration

# PostgreSQL 16 (General Relational Data) - Port 5433 to avoid host port 5432 conflict
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=gridlock
POSTGRES_USER=gridlock_admin
POSTGRES_PASSWORD=gridlock_secret_2026
DATABASE_URL=postgresql://gridlock_admin:gridlock_secret_2026@localhost:5433/gridlock

# MongoDB 7.0+ (High-Volume ML Predictions & Telemetry)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=gridlock_predictions
MONGO_USER=mongo_admin
MONGO_PASSWORD=mongo_secret_2026
MONGODB_URI=mongodb://mongo_admin:mongo_secret_2026@localhost:27017/gridlock_predictions?authSource=admin

# Security & Tokens
JWT_SECRET=gridlock_jwt_super_secret_production_key_2026
PBKDF2_SALT=gridlock_salt_secure_2026
